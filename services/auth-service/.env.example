# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/lexaauth

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=lexa-auth-service

# Token expiration times (use Go duration format: 15m, 24h, 7d)
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d
JWT_ID_TOKEN_EXPIRES=1h

# ============================================
# REDIS CONFIGURATION (Required)
# ============================================
# Used for: rate limiting, token blacklisting, distributed account lockout
# Get free Redis at: https://console.upstash.com
REDIS_URL=rediss://default:your_password@your-redis.upstash.io:6379

# Optional: Redis database numbers for different purposes (defaults: 0, 1, 2)
REDIS_DB_RATE_LIMIT=0
REDIS_DB_TOKEN_BLACKLIST=1
REDIS_DB_ACCOUNT_LOCKOUT=2

# ============================================
# EMAIL SERVICE CONFIGURATION (Gmail SMTP)
# ============================================
# Gmail SMTP configuration
# Note: You need to generate an App Password (not your regular Gmail password)
# Visit: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_digit_app_password

# Email sender configuration
FROM_EMAIL=your_gmail@gmail.com
FROM_NAME=Lexa Auth

# Frontend URL for email verification/password reset links
FRONTEND_URL=https://app.yourdomain.com

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# ============================================
# WEBAUTHN/PASSKEY CONFIGURATION
# ============================================
WEBAUTHN_DISPLAY_NAME=Lexa
WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_PORT=8080
SERVER_HOST=localhost

# For production, use 0.0.0.0 to accept connections from all interfaces
# SERVER_HOST=0.0.0.0

# Render.com automatically sets PORT environment variable
# If PORT is set, it will override SERVER_PORT

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321

# For production:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Bcrypt cost (10-14, higher = more secure but slower)
BCRYPT_COST=12

# Maximum request body size in bytes (default: 1MB)
MAX_REQUEST_BODY_SIZE=1048576

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# For development:
# LOG_LEVEL=debug

# ============================================
# PROMETHEUS METRICS (Optional)
# ============================================
# Enable Prometheus metrics endpoint at /metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# DEVELOPMENT/TESTING
# ============================================
# Environment mode: development, staging, production
ENVIRONMENT=development

# Enable debug mode (more verbose logging, stack traces)
DEBUG=false
