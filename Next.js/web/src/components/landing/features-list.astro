---
export interface Props {
  heading?: {
    title: string;
    subtitle?: string;
    tag?: string;
  };
  features?: Array<{
    id: string;
    title: string;
    description: string;
    image: {
      src: string;
      alt: string;
    };
    characteristics: Array<{
      id: string;
      title: string;
    }>;
  }>;
}

const {
  heading = {
    title: "Enhanced Team Communication",
    subtitle:
      "Simplify team discussions and collaboration with our efficient messaging features, enabling swift decision-making and project progress tracking.",
    tag: "Communication",
  },
  features = [
    {
      id: "1",
      title: "24/7 consultancy",
      description:
        "Our advanced AI operates 24/7, providing immediate legal assistance when traditional legal services are unavailable. Unlike conventional law firms with limited hours, Lexa never sleeps — offering real-time contract reviews, drafting assistance, and legal queries at 2 AM just as effectively as during business hours.",
      image: {
        src: "/media/customer-support.webp",
        alt: "Real-Time Messaging",
      },
      characteristics: [
        { id: "1", title: "24/7 AI Legal Support" },
        { id: "2", title: "Multi-Language Contracts" },
        { id: "3", title: "Regional Compliance Engine" },
        { id: "4", title: "Cross-Border Templates" },
      ],
    },
    {
      id: "3",
      title: "Secure Vault Management System",
      description:
        "Our encrypted vault system provides a secure, centralized repository for all your legal documents. Unlike traditional storage methods with security vulnerabilities, Lexa offers bank-level encryption, granular access controls, and comprehensive version history—ensuring your sensitive contracts are protected from unauthorized access while remaining instantly retrievable whenever needed.",
      image: {
        src: "https://assets.basehub.com/fa068a12/cy17qmkX79r4Q1qWtIuio/features-streamlined-team-communication-secure-communication-channels-(light-mode)3x.jpg",
        alt: "Secure Communication Channels",
      },
      characteristics: [
        { id: "1", title: "End-to-end encryption" },
        { id: "2", title: "Secure file sharing and storage" },
        { id: "3", title: "Compliance with global security standards" },
      ],
    },
    {
      id: "4",
      title: "Advanced E-Signing Capabilities",
      description:
        "Lexa's robust e-signing system offers legally binding signatures across multiple jurisdictions. With customizable signature workflows, biometric verification, and tamper-proof audit trails, our platform ensures every signed document maintains its integrity and legal validity. Users can track signature status in real-time and automate reminders for pending signatures.",
      image: { src: "/media/card-1.webp", alt: "Secure Vault Management" },
      characteristics: [
        { id: "1", title: "Multi-party signing with sequential workflows" },
        { id: "2", title: "Legal validity across 30+ jurisdictions" },
        { id: "3", title: "Automated signature reminders and notifications" },
      ],
    },
  ],
} = Astro.props;
---

<section class="px-6 py-20 max-w-6xl mx-auto">
  <!-- Heading -->
  <div class="text-center mb-16">
    {heading.tag && (
      <span class="inline-block px-3 py-1 text-sm font-medium text-neutral-600 bg-neutral-100 rounded-full mb-4">
        {heading.tag}
      </span>
    )}
    <h2 class="text-3xl sm:text-4xl font-medium text-neutral-900 mb-4">
      {heading.title}
    </h2>
    {heading.subtitle && (
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
        {heading.subtitle}
      </p>
    )}
  </div>
  
  <!-- Features List -->
  <div class="flex flex-col gap-6">
    {features.map((item, index) => (
      <article
        key={item.id}
        class={`flex min-h-96 w-full flex-col rounded-lg border border-neutral-200 bg-neutral-50 p-2 sm:max-w-full md:w-full md:flex-row ${
          index % 2 === 1 ? 'md:flex-row-reverse' : ''
        } xl:gap-16`}
      >
        <figure class="p-2 md:h-auto md:w-[360px] lg:w-[480px] xl:w-[560px]">
          <img
            src={item.image.src}
            alt={item.image.alt}
            class="block aspect-video h-[200px] w-full rounded-lg border border-neutral-200 object-cover md:h-full"
            width="560"
            height="374"
            loading="lazy"
          />
        </figure>
        <div class="flex flex-col gap-8 p-6 lg:p-8 md:flex-1">
          <div class="flex flex-col items-start gap-2">
            <h5 class="text-2xl font-medium text-neutral-900 md:text-3xl">
              {item.title}
            </h5>
            <p class="font-normal text-neutral-700 md:text-lg">
              {item.description}
            </p>
          </div>
          <ul class="flex flex-col items-start gap-3 pl-2 md:text-lg">
            {item.characteristics.map(({ id, title }) => (
              <li
                key={id}
                class="flex items-center gap-4 font-normal text-neutral-700"
              >
                <span class="flex size-6 items-center justify-center rounded-full bg-neutral-200">
                  <Check className="w-3 h-3 text-neutral-600" />
                </span>
                {title}
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>