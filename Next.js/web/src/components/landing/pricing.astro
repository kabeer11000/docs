---
export interface Props {
  heading?: {
    title: string;
    subtitle?: string;
    tag?: string;
    align?: "left" | "center" | "right";
  };
  plans?: Array<{
    id: string;
    title: string;
    price: string;
    billed: string;
    isMostPopular?: boolean;
    features: Array<{
      id: string;
      title: string;
    }>;
  }>;
}

const {
  heading = {
    title: "Packages & Pricing",
    subtitle:
      "Lexa's Pro Plan is the for Lawyers, Students & Law Firms that are looking forward for fast, efficient law solutions & legal resources.",
    tag: "Pricing",
    align: "center",
  },
  plans = [
    {
      id: "1",
      title: "Basic",
      price: "2200 PKR",
      billed: "Starter",
      isMostPopular: false,
      features: [
        { id: "1", title: "Unlimited Queries." },
        { id: "2", title: "Access to 20,000+ Judgments." },
        { id: "3", title: "Lexa All Services." },
      ],
    },
    {
      id: "2",
      title: "Pro",
      price: "19,999 PKR",
      billed: "Premium",
      isMostPopular: true,
      features: [
        { id: "1", title: "Advanced AI model access." },
        { id: "2", title: "Generous usage quota per month." },
        { id: "3", title: "Priority email and chat support." },
        { id: "4", title: "Enhanced analytics dashboard with insights." },
        { id: "5", title: "Expanded range of integration options." },
      ],
    },
    {
      id: "3",
      title: "Premium",
      price: "11,999 PKR",
      billed: "Billed annually",
      isMostPopular: false,
      features: [
        { id: "1", title: "Premium AI models with customization." },
        { id: "2", title: "Unlimited usage quota per month." },
        { id: "3", title: "Dedicated account manager support." },
        { id: "4", title: "Comprehensive analytics with predictive features." },
        { id: "5", title: "Advanced integration with APIs and platforms." },
      ],
    },
  ],
} = Astro.props;

const _alignmentClasses = {
  left: "text-left",
  center: "text-center",
  right: "text-right",
};

// Shadow SVG component for popular plan
const _shadowSvg = `
<svg fill="none" viewBox="0 0 312 175" xmlns="http://www.w3.org/2000/svg" class="pointer-events-none absolute left-0 top-0 h-full w-full origin-bottom scale-[2.0] text-blue-500">
  <g filter="url(#filter0_f_6956_27669)">
    <path
      d="M-41 398C-41 371.998 -35.9174 346.251 -26.0424 322.229C-16.1673 298.206 -1.69321 276.379 16.5535 257.993C34.8002 239.607 56.4622 225.022 80.3027 215.072C104.143 205.121 129.695 200 155.5 200C181.305 200 206.857 205.121 230.697 215.072C254.538 225.022 276.2 239.607 294.446 257.993C312.693 276.379 327.167 298.206 337.042 322.229C346.917 346.251 352 371.998 352 398L-41 398Z"
      fill="currentColor"
    />
  </g>
  <defs>
    <filter
      colorInterpolationFilters="sRGB"
      filterUnits="userSpaceOnUse"
      height="598"
      id="filter0_f_6956_27669"
      width="793"
      x="-241"
      y="0"
    >
      <feFlood floodOpacity="0" result="BackgroundImageFix" />
      <feBlend in="SourceGraphic" in2="BackgroundImageFix" mode="normal" result="shape" />
      <feGaussianBlur result="effect1_foregroundBlur_6956_27669" stdDeviation="100" />
    </filter>
  </defs>
</svg>
`;
---

<section class="px-6 py-20 max-w-6xl mx-auto" id="pricing">
  <!-- Heading -->
  <div class={`mb-16 ${alignmentClasses[heading.align || 'center']}`}>
    {heading.tag && (
      <span class="inline-block px-3 py-1 text-sm font-medium text-neutral-600 bg-neutral-100 rounded-full mb-4">
        {heading.tag}
      </span>
    )}
    <h2 class="text-3xl sm:text-4xl font-medium text-neutral-900 mb-4">
      {heading.title}
    </h2>
    {heading.subtitle && (
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
        {heading.subtitle}
      </p>
    )}
  </div>
  
  <!-- Pricing Cards -->
  <div class="flex flex-col gap-5 self-stretch lg:flex-row">
    {plans.map((plan) => (
      <article
        key={plan.id}
        class={`
          pricing-card relative flex flex-1 flex-col overflow-hidden rounded-2xl border p-8
          ${plan.isMostPopular 
            ? "border-neutral-900" 
            : "border-neutral-200"
          }
        `}
      >
        <!-- Header -->
        <header class="flex flex-col gap-4 pb-6">
          {plan.isMostPopular && (
            <span class="absolute left-1/2 top-4 -translate-x-1/2 bg-neutral-900 text-white px-3 py-1 rounded-full text-xs font-medium">
              Most popular
            </span>
          )}
          <div class="text-center mt-6">
            <span class="text-3xl font-medium lg:text-4xl text-neutral-900">{plan.price}</span>
          </div>
          <div class="flex flex-col text-center">
            <h5 class="text-lg font-medium lg:text-xl text-neutral-900">{plan.title}</h5>
            <p class="text-sm text-neutral-600 lg:text-base">
              {plan.billed}
            </p>
          </div>
        </header>
        
        <!-- Features -->
        <div class="flex flex-1 flex-col gap-6 pb-6">
          <ul class="flex flex-col gap-4">
            {plan.features.map((feature) => (
              <li
                key={feature.id}
                class="flex items-start gap-3 text-sm text-neutral-700 lg:text-base"
              >
                <svg class="mt-0.5 size-4 shrink-0 lg:size-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{feature.title}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Footer -->
        <footer class="relative flex w-full items-center self-stretch">
          <a
            href="/auth/login"
            class={`
              w-full px-6 py-3 font-medium rounded-lg transition-colors text-center
              ${plan.isMostPopular 
                ? "bg-teal-600 text-white hover:bg-teal-700" 
                : "border border-neutral-300 text-neutral-700 hover:bg-neutral-50"
              }
            `}
          >
            Get started
          </a>
        </footer>
      </article>
    ))}
  </div>
</section>

<style>
  .pricing-card {
    /* Removed box-shadow for cleaner appearance */
  }
</style>