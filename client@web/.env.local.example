# Copy to .env.local and fill in. Point at the deployed Render services
# to skip running backends locally, or at localhost ports if running
# services/* yourself (see services/README.md).

NEXT_PUBLIC_AUTH_BASE_URL=https://docs-auth-service.onrender.com
NEXT_PUBLIC_CLOUDSTORE_URI=https://docs-cloudstore-backend.onrender.com
NEXT_PUBLIC_CLOUDSTORE_DB=kabeers-docs-cl
NEXT_PUBLIC_HOCUSPOCUS_URL=wss://docs-yjs-host.onrender.com
